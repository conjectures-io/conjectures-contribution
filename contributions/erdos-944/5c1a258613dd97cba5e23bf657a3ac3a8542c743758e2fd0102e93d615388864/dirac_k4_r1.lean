/-!
# Erdős Problem 944: Dirac's 1970 Conjecture at `k = 4, r = 1` via `Z_17 ⋊ Z_4`

Unconditional, self-contained Lean 4 proof of Dirac's 1970 Conjecture in its sole
previously open case `k = 4, r = 1` (discharging the affirmative side of
`Erdos944.erdos_944.variants.dirac_conjecture.k_eq_four`):

We construct the 68-vertex, 204-edge triangle-free Cayley graph `G68` on the
semidirect product `Z_17 ⋊ Z_4` (multiplication `(a1, b1) * (a2, b2) = (a1 + 4^b1 * a2, b1 + b2)`,
encoded as `b * 17 + a : Fin 68`) with symmetric generating set
`S = {4, 13, 27, 37, 43, 57}`:
1. One explicit proper 3-coloring of `G68 \ {0}` yields 3-colorability of `G68 \ {v}`
   for every `v : Fin 68` via left-translation automorphisms, and 4-colorability of `G68`.
2. Four compact kernel-verified refutation trees (`decide +kernel`)
   prove non-3-colorability of `G68.deleteEdges {s(0, s)}` for the four edge-orbit
   representatives `s ∈ {4, 27, 37, 43}`. Left translation lifts this to all 204 edges
   of `G68` (and immediately implies `¬ G68.Colorable 3`).
3. Lifting to `ULift.{u} (Fin 68)` proves the exact universe-polymorphic predicate
   `∃ (V : Type u) (G : SimpleGraph V), G.IsErdos944 4 1`.
-/

namespace Contribution.Erdos944DiracK4R1

private def pow4 (b : Nat) : Nat :=
  match b with
  | 0 => 1
  | 1 => 4
  | 2 => 16
  | _ => 13

private def grpMulNat (x y : Nat) : Nat :=
  let b1 := x / 17
  let a1 := x % 17
  let b2 := y / 17
  let a2 := y % 17
  ((b1 + b2) % 4) * 17 + (a1 + pow4 b1 * a2) % 17

private def grpInvNat (x : Nat) : Nat :=
  let b := x / 17
  let a := x % 17
  let b' := (4 - b) % 4
  b' * 17 + (pow4 b' * ((17 - a) % 17)) % 17

private theorem grpMulNat_lt (x y : Nat) : grpMulNat x y < 68 := by
  dsimp only [grpMulNat]
  have h1 : (x / 17 + y / 17) % 4 < 4 := Nat.mod_lt _ (by decide)
  have h2 : (x % 17 + pow4 (x / 17) * (y % 17)) % 17 < 17 := Nat.mod_lt _ (by decide)
  omega

private theorem grpInvNat_lt (x : Nat) : grpInvNat x < 68 := by
  dsimp only [grpInvNat]
  have h1 : (4 - x / 17) % 4 < 4 := Nat.mod_lt _ (by decide)
  have h2 : (pow4 ((4 - x / 17) % 4) * ((17 - x % 17) % 17)) % 17 < 17 := Nat.mod_lt _ (by decide)
  omega

/-- Group multiplication in `Z_17 ⋊ Z_4` encoded on `Fin 68`. -/
def grpMul (x y : Fin 68) : Fin 68 :=
  ⟨grpMulNat x.val y.val, grpMulNat_lt x.val y.val⟩

/-- Group inverse in `Z_17 ⋊ Z_4` encoded on `Fin 68`. -/
def grpInv (x : Fin 68) : Fin 68 :=
  ⟨grpInvNat x.val, grpInvNat_lt x.val⟩

private theorem pow4_add_mod (b1 b2 : Nat) (hb1 : b1 < 4) (hb2 : b2 < 4) :
    pow4 ((b1 + b2) % 4) % 17 = (pow4 b1 * pow4 b2) % 17 := by
  interval_cases b1 <;> interval_cases b2 <;> decide

private theorem mod17_semidirect (a1 a2 a3 p1 p2 p12 : Nat)
    (hp : p12 % 17 = (p1 * p2) % 17) :
    ((a1 + p1 * a2) % 17 + p12 * a3) % 17 =
    (a1 + p1 * ((a2 + p2 * a3) % 17)) % 17 := by
  have h1 : ((a1 + p1 * a2) % 17 + p12 * a3) % 17 = (a1 + p1 * a2 + p12 * a3) % 17 := by
    rw [Nat.add_mod, Nat.mod_mod, ← Nat.add_mod]
  have h2 : (a1 + p1 * a2 + p12 * a3) % 17 = (a1 + p1 * a2 + (p1 * p2) * a3) % 17 := by
    rw [Nat.add_mod, Nat.mul_mod p12 a3, hp, ← Nat.mul_mod (p1 * p2) a3, ← Nat.add_mod]
  have h3 : a1 + p1 * a2 + p1 * p2 * a3 = a1 + p1 * (a2 + p2 * a3) := by
    rw [Nat.mul_add, Nat.mul_assoc, Nat.add_assoc]
  have h4 : (a1 + p1 * ((a2 + p2 * a3) % 17)) % 17 = (a1 + p1 * (a2 + p2 * a3)) % 17 := by
    rw [Nat.add_mod, Nat.mul_mod p1, Nat.mod_mod, ← Nat.mul_mod p1, ← Nat.add_mod]
  rw [h1, h2, h3, h4]

private theorem grpMul_assoc (x y z : Fin 68) :
    grpMul (grpMul x y) z = grpMul x (grpMul y z) := by
  apply Fin.ext
  have hx : x.val < 68 := x.isLt
  have hy : y.val < 68 := y.isLt
  have hz : z.val < 68 := z.isLt
  change grpMulNat (grpMulNat x.val y.val) z.val = grpMulNat x.val (grpMulNat y.val z.val)
  dsimp only [grpMulNat]
  have hdiv_xy : (((x.val / 17 + y.val / 17) % 4) * 17 +
      (x.val % 17 + pow4 (x.val / 17) * (y.val % 17)) % 17) / 17 =
      (x.val / 17 + y.val / 17) % 4 := by
    have hlt : (x.val % 17 + pow4 (x.val / 17) * (y.val % 17)) % 17 < 17 := Nat.mod_lt _ (by decide)
    omega
  have hmod_xy : (((x.val / 17 + y.val / 17) % 4) * 17 +
      (x.val % 17 + pow4 (x.val / 17) * (y.val % 17)) % 17) % 17 =
      (x.val % 17 + pow4 (x.val / 17) * (y.val % 17)) % 17 := by
    have hlt : (x.val % 17 + pow4 (x.val / 17) * (y.val % 17)) % 17 < 17 := Nat.mod_lt _ (by decide)
    omega
  have hdiv_yz : (((y.val / 17 + z.val / 17) % 4) * 17 +
      (y.val % 17 + pow4 (y.val / 17) * (z.val % 17)) % 17) / 17 =
      (y.val / 17 + z.val / 17) % 4 := by
    have hlt : (y.val % 17 + pow4 (y.val / 17) * (z.val % 17)) % 17 < 17 := Nat.mod_lt _ (by decide)
    omega
  have hmod_yz : (((y.val / 17 + z.val / 17) % 4) * 17 +
      (y.val % 17 + pow4 (y.val / 17) * (z.val % 17)) % 17) % 17 =
      (y.val % 17 + pow4 (y.val / 17) * (z.val % 17)) % 17 := by
    have hlt : (y.val % 17 + pow4 (y.val / 17) * (z.val % 17)) % 17 < 17 := Nat.mod_lt _ (by decide)
    omega
  rw [hdiv_xy, hmod_xy, hdiv_yz, hmod_yz]
  have hb_eq : ((x.val / 17 + y.val / 17) % 4 + z.val / 17) % 4 =
      (x.val / 17 + (y.val / 17 + z.val / 17) % 4) % 4 := by omega
  have hp4 : pow4 ((x.val / 17 + y.val / 17) % 4) % 17 =
      (pow4 (x.val / 17) * pow4 (y.val / 17)) % 17 :=
    pow4_add_mod (x.val / 17) (y.val / 17) (by omega) (by omega)
  have ha_eq := mod17_semidirect (x.val % 17) (y.val % 17) (z.val % 17)
    (pow4 (x.val / 17)) (pow4 (y.val / 17)) (pow4 ((x.val / 17 + y.val / 17) % 4)) hp4
  rw [hb_eq, ha_eq]

private theorem grpMul_zero_left : ∀ x : Fin 68, grpMul 0 x = x := by decide

private theorem grpMul_zero_right : ∀ x : Fin 68, grpMul x 0 = x := by decide

private theorem grpMul_inv_self : ∀ x : Fin 68, grpMul (grpInv x) x = 0 := by decide

private theorem grpMul_self_inv : ∀ x : Fin 68, grpMul x (grpInv x) = 0 := by decide

private theorem grpInv_inv : ∀ x : Fin 68, grpInv (grpInv x) = x := by decide

private theorem grpInv_mul (x y : Fin 68) :
    grpInv (grpMul x y) = grpMul (grpInv y) (grpInv x) := by
  have h1 : grpMul (grpInv (grpMul x y)) (grpMul x y) = 0 := grpMul_inv_self (grpMul x y)
  calc
    grpInv (grpMul x y) = grpMul (grpInv (grpMul x y)) 0 := (grpMul_zero_right _).symm
    _ = grpMul (grpInv (grpMul x y)) (grpMul (grpMul x y) (grpMul (grpInv y) (grpInv x))) := by
          congr 1
          rw [grpMul_assoc, ← grpMul_assoc y, grpMul_self_inv, grpMul_zero_left, grpMul_self_inv]
    _ = grpMul (grpMul (grpInv (grpMul x y)) (grpMul x y)) (grpMul (grpInv y) (grpInv x)) := by
          rw [← grpMul_assoc (grpInv (grpMul x y))]
    _ = grpMul (grpInv y) (grpInv x) := by rw [h1, grpMul_zero_left]

private theorem grpMul_inv_mul_left (g x y : Fin 68) :
    grpMul (grpInv (grpMul g x)) (grpMul g y) = grpMul (grpInv x) y := by
  rw [grpInv_mul, grpMul_assoc, ← grpMul_assoc (grpInv g), grpMul_inv_self, grpMul_zero_left]

private theorem grpMul_inv_eq_zero_iff (x y : Fin 68) :
    grpMul (grpInv x) y = 0 ↔ x = y := by
  constructor
  · intro h
    calc
      x = grpMul x 0 := (grpMul_zero_right x).symm
      _ = grpMul x (grpMul (grpInv x) y) := by rw [h]
      _ = grpMul (grpMul x (grpInv x)) y := (grpMul_assoc x (grpInv x) y).symm
      _ = y := by rw [grpMul_self_inv, grpMul_zero_left]
  · rintro rfl
    exact grpMul_inv_self x

private theorem grpMul_left_injective (g : Fin 68) : Function.Injective (grpMul g) := by
  intro x y h
  have := congrArg (grpMul (grpInv g)) h
  simpa [← grpMul_assoc, grpMul_inv_self, grpMul_zero_left] using this

private def isGen (d : Nat) : Bool :=
  d == 4 || d == 13 || d == 27 || d == 37 || d == 43 || d == 57

private theorem isGen_inv : ∀ d : Fin 68, isGen (grpInv d).val = isGen d.val := by decide

private def adj68Nat (x y : Nat) : Bool :=
  isGen (grpMulNat (grpInvNat x) y)

private def adj68 (x y : Fin 68) : Bool :=
  isGen (grpMul (grpInv x) y).val

private theorem adj68_eq_nat (x y : Fin 68) : adj68 x y = adj68Nat x.val y.val := rfl

private theorem adj68_symm (x y : Fin 68) : adj68 x y = adj68 y x := by
  unfold adj68
  rw [← isGen_inv (grpMul (grpInv x) y), grpInv_mul, grpInv_inv]

private theorem adj68_irrefl (x : Fin 68) : adj68 x x = false := by
  unfold adj68
  rw [grpMul_inv_self]
  decide

/-- The 68-vertex, 204-edge Cayley graph on `Z_17 ⋊ Z_4` with generating set `{4, 13, 27, 37, 43, 57}`. -/
def G68 : SimpleGraph (Fin 68) where
  Adj x y := adj68 x y = true
  symm := ⟨fun x y h => by rw [adj68_symm]; exact h⟩
  loopless := ⟨fun x h => by rw [adj68_irrefl x] at h; cases h⟩

private theorem G68_adj_mul_left (g x y : Fin 68) :
    G68.Adj (grpMul g x) (grpMul g y) ↔ G68.Adj x y := by
  change adj68 (grpMul g x) (grpMul g y) = true ↔ adj68 x y = true
  simp only [adj68, grpMul_inv_mul_left]

private def colTable : Array (Fin 3) :=
  #[0, 0, 2, 1, 0, 1, 1, 2, 1, 0, 0, 1, 0, 2, 2, 0, 2, 1, 0, 1, 2, 0, 1, 0, 1, 2, 0, 1, 2, 0, 2, 1, 2, 0, 0, 2, 1, 2, 1, 1, 0, 1, 0, 0, 1, 0, 2, 2, 0, 2, 0, 0, 1, 0, 1, 2, 0, 1, 2, 1, 0, 1, 2, 0, 1, 2, 1, 2]

private def col3MinusZero (v : Fin 68) : Fin 3 :=
  colTable.getD v.val 0

private theorem col3MinusZero_valid_gen :
    ∀ u : Fin 68, ∀ d : Fin 68,
      isGen d.val = true → u ≠ 0 → grpMul u d ≠ 0 →
      col3MinusZero u ≠ col3MinusZero (grpMul u d) := by
  decide +kernel

private theorem col3MinusZero_valid (u v : Fin 68) (hu : u ≠ 0) (hv : v ≠ 0)
    (hadj : G68.Adj u v) : col3MinusZero u ≠ col3MinusZero v := by
  let d := grpMul (grpInv u) v
  have hgen : isGen d.val = true := hadj
  have huv : grpMul u d = v := by
    dsimp [d]
    rw [← grpMul_assoc, grpMul_self_inv, grpMul_zero_left]
  rw [← huv] at hv ⊢
  exact col3MinusZero_valid_gen u d hgen hu hv

/-- Explicit proper 4-coloring of `G68`. -/
theorem G68_colorable_four : G68.Colorable 4 := by
  refine ⟨SimpleGraph.Coloring.mk
    (fun v => if v = 0 then 3 else (col3MinusZero v).castSucc) ?_⟩
  intro u v huv h_eq
  by_cases hu : u = 0 <;> by_cases hv : v = 0
  · subst hu; subst hv; exact huv.ne rfl
  · subst hu
    simp only [hv, ↓reduceIte] at h_eq
    have h3 : (3 : Fin 4).val = (col3MinusZero v).castSucc.val := congrArg Fin.val h_eq
    have hlt := (col3MinusZero v).isLt
    simp at h3
    omega
  · subst hv
    simp only [hu, ↓reduceIte] at h_eq
    have h3 : (col3MinusZero u).castSucc.val = (3 : Fin 4).val := congrArg Fin.val h_eq
    have hlt := (col3MinusZero u).isLt
    simp at h3
    omega
  · simp only [hu, hv, ↓reduceIte] at h_eq
    have hval : col3MinusZero u = col3MinusZero v := by
      apply Fin.ext
      simpa using congrArg Fin.val h_eq
    exact col3MinusZero_valid u v hu hv huv hval

/-- Deleting any single vertex `v` from `G68` yields a 3-colorable graph. -/
theorem G68_deleteVert_colorable_three (v : Fin 68) :
    ((⊤ : G68.Subgraph).deleteVerts {v}).coe.Colorable 3 := by
  refine ⟨SimpleGraph.Coloring.mk (fun x => col3MinusZero (grpMul (grpInv v) x.val)) ?_⟩
  intro x y hxy
  rw [SimpleGraph.Subgraph.coe_adj, SimpleGraph.Subgraph.deleteVerts_adj] at hxy
  rcases hxy with ⟨_, hx_ne, _, hy_ne, hadj⟩
  have h1 : grpMul (grpInv v) x.val ≠ 0 := fun h => hx_ne ((grpMul_inv_eq_zero_iff v x.val).mp h).symm
  have h2 : grpMul (grpInv v) y.val ≠ 0 := fun h => hy_ne ((grpMul_inv_eq_zero_iff v y.val).mp h).symm
  have hadj' : G68.Adj (grpMul (grpInv v) x.val) (grpMul (grpInv v) y.val) :=
    (G68_adj_mul_left (grpInv v) x.val y.val).mpr hadj
  exact col3MinusZero_valid _ _ h1 h2 hadj'

private def adjDel (s x y : Nat) : Bool :=
  adj68Nat x y && !((x == 0 && y == s) || (x == s && y == 0))

private inductive Trie
  | leaf (c : Nat)
  | node (t0 t1 t2 t3 : Trie)

private def Trie.empty : Trie :=
  let z := Trie.leaf 0
  let n1 := Trie.node z z z z
  let n2 := Trie.node n1 n1 n1 n1
  let n3 := Trie.node n2 n2 n2 n2
  Trie.node n3 n3 n3 n3

private def Trie.get : Trie → Nat → Nat
  | Trie.leaf c, _ => c
  | Trie.node t0 t1 t2 t3, k =>
    match k % 4 with
    | 0 => t0.get (k / 4)
    | 1 => t1.get (k / 4)
    | 2 => t2.get (k / 4)
    | _ => t3.get (k / 4)

private def Trie.set : Trie → Nat → Nat → Trie
  | Trie.leaf _, _, c => Trie.leaf c
  | Trie.node t0 t1 t2 t3, k, c =>
    match k % 4 with
    | 0 => Trie.node (t0.set (k / 4) c) t1 t2 t3
    | 1 => Trie.node t0 (t1.set (k / 4) c) t2 t3
    | 2 => Trie.node t0 t1 (t2.set (k / 4) c) t3
    | _ => Trie.node t0 t1 t2 (t3.set (k / 4) c)

private inductive Depth : Nat → Trie → Prop
  | leaf (c : Nat) : Depth 0 (Trie.leaf c)
  | node {d : Nat} {t0 t1 t2 t3 : Trie} :
      Depth d t0 → Depth d t1 → Depth d t2 → Depth d t3 →
      Depth (d + 1) (Trie.node t0 t1 t2 t3)

private theorem depth_empty : Depth 4 Trie.empty := by
  unfold Trie.empty
  repeat (first | apply Depth.node | apply Depth.leaf)

private theorem depth_set {d : Nat} {t : Trie} (hd : Depth d t) (k c : Nat) :
    Depth d (t.set k c) := by
  induction hd generalizing k with
  | leaf _ => exact Depth.leaf c
  | node h0 h1 h2 h3 ih0 ih1 ih2 ih3 =>
    simp only [Trie.set]
    split
    · exact Depth.node (ih0 _) h1 h2 h3
    · exact Depth.node h0 (ih1 _) h2 h3
    · exact Depth.node h0 h1 (ih2 _) h3
    · exact Depth.node h0 h1 h2 (ih3 _)

private theorem get_empty (k : Nat) : Trie.empty.get k = 0 := by
  have h : ∀ t : Trie, (∀ x, t.get x = 0) → ∀ x, (Trie.node t t t t).get x = 0 := by
    intro t ht x
    simp only [Trie.get]
    split <;> exact ht _
  exact h _ (h _ (h _ (h _ (fun _ => rfl)))) k

private theorem get_set_of_depth {d : Nat} {t : Trie} (hd : Depth d t)
    (v w c : Nat) (hv : v < 4 ^ d) (hw : w < 4 ^ d) :
    (t.set v c).get w = if w = v then c else t.get w := by
  induction hd generalizing v w with
  | leaf c0 =>
    have hv0 : v = 0 := by omega
    have hw0 : w = 0 := by omega
    subst hv0; subst hw0
    rfl
  | @node d' t0 t1 t2 t3 h0 h1 h2 h3 ih0 ih1 ih2 ih3 =>
    have hv' : v / 4 < 4 ^ d' := by
      rw [Nat.pow_succ] at hv; omega
    have hw' : w / 4 < 4 ^ d' := by
      rw [Nat.pow_succ] at hw; omega
    have hmod_v : v % 4 < 4 := Nat.mod_lt v (by decide)
    have hmod_w : w % 4 < 4 := Nat.mod_lt w (by decide)
    simp only [Trie.set]
    interval_cases hvm : v % 4
    · simp only [Trie.get]
      interval_cases hwm : w % 4
      · rw [ih0 _ _ hv' hw']
        have hiff : (w / 4 = v / 4) ↔ (w = v) := by omega
        simp [hiff]
      · have hne : w ≠ v := by omega
        simp [hne]
      · have hne : w ≠ v := by omega
        simp [hne]
      · have hne : w ≠ v := by omega
        simp [hne]
    · simp only [Trie.get]
      interval_cases hwm : w % 4
      · have hne : w ≠ v := by omega
        simp [hne]
      · rw [ih1 _ _ hv' hw']
        have hiff : (w / 4 = v / 4) ↔ (w = v) := by omega
        simp [hiff]
      · have hne : w ≠ v := by omega
        simp [hne]
      · have hne : w ≠ v := by omega
        simp [hne]
    · simp only [Trie.get]
      interval_cases hwm : w % 4
      · have hne : w ≠ v := by omega
        simp [hne]
      · have hne : w ≠ v := by omega
        simp [hne]
      · rw [ih2 _ _ hv' hw']
        have hiff : (w / 4 = v / 4) ↔ (w = v) := by omega
        simp [hiff]
      · have hne : w ≠ v := by omega
        simp [hne]
    · simp only [Trie.get]
      interval_cases hwm : w % 4
      · have hne : w ≠ v := by omega
        simp [hne]
      · have hne : w ≠ v := by omega
        simp [hne]
      · have hne : w ≠ v := by omega
        simp [hne]
      · rw [ih3 _ _ hv' hw']
        have hiff : (w / 4 = v / 4) ↔ (w = v) := by omega
        simp [hiff]

private inductive Refut
  | k (u v : Nat)
  | f (v u1 u2 : Nat) (nxt : Refut)
  | b (v : Nat) (t0 t1 t2 : Refut)

private def checkRefut (s : Nat) (env : Trie) : Refut → Bool
  | .k u v =>
    let cu := env.get u
    u < 68 && v < 68 && cu != 0 && cu == env.get v && adjDel s u v
  | .f v u1 u2 nxt =>
    let c1 := env.get u1
    let c2 := env.get u2
    v < 68 && u1 < 68 && u2 < 68 && c1 != 0 && c2 != 0 && c1 != c2 &&
      adjDel s u1 v && adjDel s u2 v &&
      checkRefut s (env.set v (6 - c1 - c2)) nxt
  | .b v t0 t1 t2 =>
    v < 68 &&
    checkRefut s (env.set v 1) t0 &&
    checkRefut s (env.set v 2) t1 &&
    checkRefut s (env.set v 3) t2

private def Matches (col : Fin 68 → Fin 3) (env : Trie) : Prop :=
  ∀ v : Fin 68, env.get v.val = 0 ∨ env.get v.val = (col v).val + 1

private theorem matches_empty (col : Fin 68 → Fin 3) : Matches col Trie.empty := fun v =>
  Or.inl (get_empty v.val)

private theorem matches_set {col : Fin 68 → Fin 3} {env : Trie}
    (hd : Depth 4 env) (hm : Matches col env) (v : Fin 68) :
    Matches col (env.set v.val ((col v).val + 1)) := by
  intro w
  rw [get_set_of_depth hd v.val w.val _ (by have := v.isLt; omega) (by have := w.isLt; omega)]
  by_cases hEq : w.val = v.val
  · have hfv : w = v := Fin.ext hEq
    subst hfv
    simp
  · simp only [hEq, ↓reduceIte]
    exact hm w

private theorem adjDel_sound {s u v : Fin 68}
    (h : adjDel s.val u.val v.val = true) :
    (G68.deleteEdges {s(0, s)}).Adj u v := by
  simp only [adjDel, Bool.and_eq_true, Bool.not_eq_true', Bool.or_eq_false_iff,
    Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq] at h
  rw [SimpleGraph.deleteEdges_adj, Set.mem_singleton_iff]
  refine ⟨by change adj68 u v = true; rw [adj68_eq_nat]; exact h.1, fun hpair => ?_⟩
  rcases Sym2.eq_iff.mp hpair with ⟨hu0, hvs⟩ | ⟨hus, hv0⟩
  · rcases h.2.1 with hne | hne
    · exact hne (congrArg Fin.val hu0)
    · exact hne (congrArg Fin.val hvs)
  · rcases h.2.2 with hne | hne
    · exact hne (congrArg Fin.val hus)
    · exact hne (congrArg Fin.val hv0)

private theorem checkRefut_sound {s : Fin 68}
    (col : (G68.deleteEdges {s(0, s)}).Coloring (Fin 3))
    (env : Trie) (hd : Depth 4 env) (hm : Matches col env) (t : Refut)
    (hok : checkRefut s.val env t = true) : False := by
  induction t generalizing env with
  | k u v =>
    simp only [checkRefut, Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq,
      beq_iff_eq] at hok
    rcases hok with ⟨⟨⟨⟨hu, hv⟩, hcu0⟩, hceq⟩, hadj⟩
    let fu : Fin 68 := ⟨u, hu⟩
    let fv : Fin 68 := ⟨v, hv⟩
    have hmu : env.get u = (col fu).val + 1 := (hm fu).resolve_left hcu0
    have hmv : env.get v = (col fv).val + 1 := (hm fv).resolve_left (by rw [← hceq]; exact hcu0)
    have hcol : col fu = col fv := Fin.ext (by omega)
    have hadj_g : (G68.deleteEdges {s(0, s)}).Adj fu fv := adjDel_sound (u := fu) (v := fv) hadj
    exact col.valid hadj_g hcol
  | f v u1 u2 nxt ih =>
    simp only [checkRefut, Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq] at hok
    rcases hok with ⟨⟨⟨⟨⟨⟨⟨⟨hv, hu1⟩, hu2⟩, hc10⟩, hc20⟩, hc12⟩, ha1⟩, ha2⟩, hnxt⟩
    let fv : Fin 68 := ⟨v, hv⟩
    let fu1 : Fin 68 := ⟨u1, hu1⟩
    let fu2 : Fin 68 := ⟨u2, hu2⟩
    have hm1 : env.get u1 = (col fu1).val + 1 := (hm fu1).resolve_left hc10
    have hm2 : env.get u2 = (col fu2).val + 1 := (hm fu2).resolve_left hc20
    have hadj1 : (G68.deleteEdges {s(0, s)}).Adj fu1 fv := adjDel_sound (u := fu1) (v := fv) ha1
    have hadj2 : (G68.deleteEdges {s(0, s)}).Adj fu2 fv := adjDel_sound (u := fu2) (v := fv) ha2
    have hne1 : col fu1 ≠ col fv := col.valid hadj1
    have hne2 : col fu2 ≠ col fv := col.valid hadj2
    have hv_lt := (col fv).isLt
    have h1_lt := (col fu1).isLt
    have h2_lt := (col fu2).isLt
    have hval1 : (col fu1).val ≠ (col fv).val := fun h => hne1 (Fin.ext h)
    have hval2 : (col fu2).val ≠ (col fv).val := fun h => hne2 (Fin.ext h)
    have hforce : 6 - env.get u1 - env.get u2 = (col fv).val + 1 := by omega
    rw [hforce] at hnxt
    exact ih (env.set v ((col fv).val + 1)) (depth_set hd _ _) (matches_set hd hm fv) hnxt
  | b v t0 t1 t2 ih0 ih1 ih2 =>
    simp only [checkRefut, Bool.and_eq_true, decide_eq_true_eq] at hok
    rcases hok with ⟨⟨⟨hv, h0⟩, h1⟩, h2⟩
    let fv : Fin 68 := ⟨v, hv⟩
    have hlt := (col fv).isLt
    have hcases : (col fv).val = 0 ∨ (col fv).val = 1 ∨ (col fv).val = 2 := by omega
    rcases hcases with hc0 | hc1 | hc2
    · have hm' := matches_set hd hm fv
      rw [hc0] at hm'
      exact ih0 _ (depth_set hd _ _) hm' h0
    · have hm' := matches_set hd hm fv
      rw [hc1] at hm'
      exact ih1 _ (depth_set hd _ _) hm' h1
    · have hm' := matches_set hd hm fv
      rw [hc2] at hm'
      exact ih2 _ (depth_set hd _ _) hm' h2

private def perm3 (a b x : Fin 3) : Fin 3 :=
  if x = a then 0 else if x = b then 1 else 2

private theorem perm3_injective :
    ∀ a b x y : Fin 3, a ≠ b → perm3 a b x = perm3 a b y → x = y := by
  decide

private theorem not_col3_of_cert (s other : Fin 68) (t : Refut)
    (hother : (G68.deleteEdges {s(0, s)}).Adj 0 other)
    (hok : checkRefut s.val ((Trie.empty.set 0 1).set other.val 2) t = true) :
    ¬ (G68.deleteEdges {s(0, s)}).Colorable 3 := by
  rintro ⟨col⟩
  have hne : col 0 ≠ col other := col.valid hother
  let col' : (G68.deleteEdges {s(0, s)}).Coloring (Fin 3) :=
    SimpleGraph.Coloring.mk (fun v => perm3 (col 0) (col other) (col v)) fun hxy h_eq =>
      col.valid hxy (perm3_injective (col 0) (col other) _ _ hne h_eq)
  have hcol'0 : (col' 0).val + 1 = 1 := by
    change (perm3 (col 0) (col other) (col 0)).val + 1 = 1
    simp [perm3]
  have hcol'1 : (col' other).val + 1 = 2 := by
    change (perm3 (col 0) (col other) (col other)).val + 1 = 2
    simp [perm3, hne.symm]
  have hd1 : Depth 4 (Trie.empty.set 0 1) := depth_set depth_empty 0 1
  have hm1 : Matches col' (Trie.empty.set 0 1) := by
    simpa [hcol'0] using matches_set depth_empty (matches_empty col') 0
  have hd2 : Depth 4 ((Trie.empty.set 0 1).set other.val 2) := depth_set hd1 other.val 2
  have hm2 : Matches col' ((Trie.empty.set 0 1).set other.val 2) := by
    simpa [hcol'1] using matches_set hd1 hm1 other
  exact checkRefut_sound col' _ hd2 hm2 t hok


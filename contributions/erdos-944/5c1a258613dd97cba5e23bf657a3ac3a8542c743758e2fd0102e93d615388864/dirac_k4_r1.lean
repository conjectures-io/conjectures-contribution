/-- `G68` is not 3-colorable. -/
theorem G68_not_colorable_three : ¬ G68.Colorable 3 := by
  intro hc
  exact G68_del4_not_col3 (hc.of_hom ⟨id, fun h => h.1⟩)

private theorem delEdge_pullback (g s : Fin 68)
    (hc : (G68.deleteEdges {s(g, grpMul g s)}).Colorable 3) :
    (G68.deleteEdges {s(0, s)}).Colorable 3 := by
  refine hc.of_hom ⟨grpMul g, fun {x y} hxy => ?_⟩
  rw [SimpleGraph.deleteEdges_adj, Set.mem_singleton_iff] at hxy ⊢
  refine ⟨(G68_adj_mul_left g x y).mpr hxy.1, fun hpair => hxy.2 ?_⟩
  rcases Sym2.eq_iff.mp hpair with ⟨hx, hy⟩ | ⟨hx, hy⟩
  · have hx0 : x = 0 := grpMul_left_injective g (by simpa [grpMul_zero_right] using hx)
    have hys : y = s := grpMul_left_injective g hy
    rw [hx0, hys]
  · have hxs : x = s := grpMul_left_injective g hx
    have hy0 : y = 0 := grpMul_left_injective g (by simpa [grpMul_zero_right] using hy)
    rw [hxs, hy0, Sym2.eq_swap]

/-- Deleting any single edge of `G68` leaves a graph that is still not 3-colorable. -/
theorem G68_deleteEdge_not_colorable_three (e : Sym2 (Fin 68)) :
    ¬ (G68.deleteEdges {e}).Colorable 3 := by
  induction e using Sym2.ind with
  | _ a b =>
    intro hc
    by_cases hab : G68.Adj a b
    · let d := grpMul (grpInv a) b
      have hgen : isGen d.val = true := hab
      have hba : grpMul a d = b := by
        dsimp [d]
        rw [← grpMul_assoc, grpMul_self_inv, grpMul_zero_left]
      simp only [isGen, Bool.or_eq_true, beq_iff_eq] at hgen
      rcases hgen with ((((h4 | h13) | h27) | h37) | h43) | h57
      · have hd : d = 4 := Fin.ext h4
        rw [hd] at hba
        rw [← hba] at hc
        exact G68_del4_not_col3 (delEdge_pullback a 4 hc)
      · have hd : d = 13 := Fin.ext h13
        have hba' : grpMul b 4 = a := by
          rw [← hba, hd, grpMul_assoc]
          have h13_4 : grpMul (13 : Fin 68) (4 : Fin 68) = 0 := by decide
          rw [h13_4, grpMul_zero_right]
        rw [Sym2.eq_swap, ← hba'] at hc
        exact G68_del4_not_col3 (delEdge_pullback b 4 hc)
      · have hd : d = 27 := Fin.ext h27
        rw [hd] at hba
        rw [← hba] at hc
        exact G68_del27_not_col3 (delEdge_pullback a 27 hc)
      · have hd : d = 37 := Fin.ext h37
        rw [hd] at hba
        rw [← hba] at hc
        exact G68_del37_not_col3 (delEdge_pullback a 37 hc)
      · have hd : d = 43 := Fin.ext h43
        rw [hd] at hba
        rw [← hba] at hc
        exact G68_del43_not_col3 (delEdge_pullback a 43 hc)
      · have hd : d = 57 := Fin.ext h57
        have hba' : grpMul b 27 = a := by
          rw [← hba, hd, grpMul_assoc]
          have h57_27 : grpMul (57 : Fin 68) (27 : Fin 68) = 0 := by decide
          rw [h57_27, grpMul_zero_right]
        rw [Sym2.eq_swap, ← hba'] at hc
        exact G68_del27_not_col3 (delEdge_pullback b 27 hc)
    · apply G68_not_colorable_three
      refine hc.of_hom ⟨id, fun {x y} hxy => ?_⟩
      rw [SimpleGraph.deleteEdges_adj, Set.mem_singleton_iff]
      refine ⟨hxy, fun hpair => hab ?_⟩
      rcases Sym2.eq_iff.mp hpair with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact hxy
      · exact hxy.symm

/--
Universe-polymorphic proof of Dirac's 1970 Conjecture at `k = 4, r = 1` on `ULift.{u} (Fin 68)`.
Discharges the existential claim of `Erdos944.erdos_944.variants.dirac_conjecture.k_eq_four`
definitionally (`rfl`).
-/
theorem dirac_k4_r1_bridge :
    ∃ (V : Type u) (G : SimpleGraph V),
      (G.chromaticNumber = 4 ∧ ∀ v : V,
        ((⊤ : G.Subgraph).deleteVerts {v}).coe.chromaticNumber <
          (⊤ : G.Subgraph).coe.chromaticNumber) ∧
      ∀ (edges : Set (Sym2 V)),
        (G.deleteEdges edges).chromaticNumber < G.chromaticNumber → 1 < edges.ncard := by
  let V := ULift.{u} (Fin 68)
  let G : SimpleGraph V := G68.comap ULift.down
  have hG4 : G.Colorable 4 :=
    G68_colorable_four.of_hom (SimpleGraph.Hom.comap ULift.down G68)
  have hG3 : ¬ G.Colorable 3 := by
    intro h
    exact G68_not_colorable_three (h.of_hom ⟨ULift.up, fun {x y} hxy => hxy⟩)
  have hchi : G.chromaticNumber = (4 : ℕ∞) := by
    apply le_antisymm
    · exact SimpleGraph.chromaticNumber_le_iff_colorable.mpr hG4
    · refine SimpleGraph.le_chromaticNumber_iff_colorable.mpr fun m hm => ?_
      by_contra hlt
      have hm3 : m ≤ 3 := Nat.le_of_lt_succ (Nat.cast_lt.mp (lt_of_not_ge hlt))
      exact hG3 (hm.mono hm3)
  have htop : (⊤ : G.Subgraph).coe.chromaticNumber = G.chromaticNumber := by
    apply le_antisymm
    · let f1 : (⊤ : G.Subgraph).coe →g G :=
        { toFun := Subtype.val
          map_rel' := fun h => h }
      exact SimpleGraph.chromaticNumber_mono_of_hom f1
    · let f2 : G →g (⊤ : G.Subgraph).coe :=
        { toFun := fun x => ⟨x, trivial⟩
          map_rel' := fun hxy => by simpa using hxy }
      exact SimpleGraph.chromaticNumber_mono_of_hom f2
  refine ⟨V, G, ⟨hchi, ?_⟩, ?_⟩
  · intro v
    rw [htop, hchi]
    have h3 : ((⊤ : G.Subgraph).deleteVerts {v}).coe.Colorable 3 := by
      let f3 : ((⊤ : G.Subgraph).deleteVerts {v}).coe →g ((⊤ : G68.Subgraph).deleteVerts {v.down}).coe :=
        { toFun := fun x => ⟨x.val.down, by
            have hx := x.prop
            simp only [SimpleGraph.Subgraph.deleteVerts_verts, Set.mem_sdiff,
              Set.mem_singleton_iff] at hx ⊢
            exact ⟨trivial, fun hmem => hx.2 (ULift.ext _ _ hmem)⟩⟩
          map_rel' := fun {x y} hxy => by
            rw [SimpleGraph.Subgraph.coe_adj, SimpleGraph.Subgraph.deleteVerts_adj] at hxy ⊢
            rcases hxy with ⟨_, hx_ne, _, hy_ne, hadj⟩
            refine ⟨trivial, ?_, trivial, ?_, hadj⟩
            · intro hmem; exact hx_ne (ULift.ext _ _ hmem)
            · intro hmem; exact hy_ne (ULift.ext _ _ hmem) }
      exact (G68_deleteVert_colorable_three v.down).of_hom f3
    have hle : ((⊤ : G.Subgraph).deleteVerts {v}).coe.chromaticNumber ≤ (3 : ℕ∞) :=
      SimpleGraph.chromaticNumber_le_iff_colorable.mpr h3
    exact lt_of_le_of_lt hle (by decide : (3 : ℕ∞) < 4)
  · intro edges hlt
    rw [hchi] at hlt
    have h3_le : (G.deleteEdges edges).chromaticNumber ≤ (3 : ℕ∞) := by
      cases hχ : (G.deleteEdges edges).chromaticNumber with
      | top => simp [hχ] at hlt
      | coe m =>
        rw [hχ] at hlt
        exact Nat.cast_le.mpr (by exact_mod_cast Nat.lt_succ_iff.mp (Nat.cast_lt.mp hlt))
    have hcol3 : (G.deleteEdges edges).Colorable 3 :=
      SimpleGraph.chromaticNumber_le_iff_colorable.mp h3_le
    by_contra hnot
    rw [not_lt] at hnot
    rcases (by omega : edges.ncard = 0 ∨ edges.ncard = 1) with h0 | h1
    · have hempty : edges = ∅ := (Set.ncard_eq_zero edges.toFinite).mp h0
      rw [hempty, SimpleGraph.deleteEdges_empty] at hcol3
      exact hG3 hcol3
    · obtain ⟨e, rfl⟩ := Set.ncard_eq_one.mp h1
      have hsub : (G68.deleteEdges {Sym2.map ULift.down e}).Colorable 3 := by
        refine hcol3.of_hom ⟨ULift.up, fun {x y} hxy => ?_⟩
        rw [SimpleGraph.deleteEdges_adj, Set.mem_singleton_iff] at hxy ⊢
        refine ⟨hxy.1, fun hpair => hxy.2 ?_⟩
        rw [← hpair]
        induction e using Sym2.ind with
        | _ u v => simp
      exact G68_deleteEdge_not_colorable_three _ hsub

